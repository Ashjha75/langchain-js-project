# 🌍 Environment Configuration for IntelliChat Backend

# ==========================================
# Core Application Settings
# ==========================================
NODE_ENV=development
PORT=3001
API_VERSION=v1
APP_NAME="IntelliChat Pro Backend"

# ==========================================
# Frontend Configuration
# ==========================================
FRONTEND_URL=http://localhost:3000
FRONTEND_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# Database Configuration
# ==========================================
# MongoDB
MONGODB_URI=mongodb://localhost:27017/intellichat
MONGODB_DB_NAME=intellichat
MONGODB_TEST_URI=mongodb://localhost:27017/intellichat_test

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TEST_DB=1

# Database Options
DB_POOL_SIZE=10
DB_TIMEOUT=10000
DB_RETRY_WRITES=true

# ==========================================
# Authentication & Security
# ==========================================
# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_in_production
JWT_EXPIRE_TIME=15m
JWT_REFRESH_EXPIRE_TIME=7d

# Session Configuration
SESSION_SECRET=your_super_secure_session_secret_change_in_production
SESSION_MAX_AGE=86400000

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# Security Headers
SECURITY_CORS_ENABLED=true
SECURITY_HELMET_ENABLED=true
SECURITY_RATE_LIMIT_ENABLED=true

# ==========================================
# AI Services Configuration
# ==========================================
# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_DEFAULT=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7
GROQ_TOP_P=0.9
GROQ_TIMEOUT=30000

# Tool Configuration
TOOL_ENABLED=true
TOOL_TIMEOUT=10000
TOOL_MAX_CONCURRENT=5

# Token Limits (Development: Set high for testing, Production: Adjust per plan)
DEFAULT_TOKEN_LIMIT=10000000
ENABLE_TOKEN_LIMIT_CHECK=false

# External APIs
TAVILY_API_KEY=your_tavily_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Logging Configuration
# ==========================================
# Log Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_ERROR_FILE_PATH=logs/error.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# Request Logging
LOG_REQUESTS=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ==========================================
# File Upload Configuration
# ==========================================
# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,text/markdown

# File Storage
UPLOAD_DIR=uploads
TEMP_DIR=temp
STATIC_DIR=public

# ==========================================
# WebSocket Configuration
# ==========================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/socket.io
WEBSOCKET_CORS_ORIGINS=http://localhost:3000
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000

# ==========================================
# Performance & Optimization
# ==========================================
# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_KEYS=1000
MEMORY_CACHE_ENABLED=true

# Request Timeout
REQUEST_TIMEOUT=30000
SLOW_REQUEST_THRESHOLD=5000

# ==========================================
# Monitoring & Health Checks
# ==========================================
# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000

# Metrics
METRICS_ENABLED=false
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_PORT=9464

# Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=development

# ==========================================
# Email Configuration (Optional)
# ==========================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@intellichat.pro

# ==========================================
# Development & Testing
# ==========================================
# Development Options
DEV_SEED_DATABASE=true
DEV_AUTO_MIGRATE=true
DEV_SWAGGER_ENABLED=true
DEV_CORS_ALL_ORIGINS=true

# Testing
TEST_TIMEOUT=10000
TEST_PARALLEL=true
TEST_COVERAGE_THRESHOLD=80

# ==========================================
# Production Overrides
# ==========================================
# These should be overridden in production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/intellichat
# REDIS_URL=redis://username:password@host:port
# GROQ_API_KEY=gsk_live_key_here
# JWT_SECRET=production_jwt_secret_256_chars_minimum
# SESSION_SECRET=production_session_secret_256_chars_minimum
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
# LOG_LEVEL=warn
# NODE_ENV=production
