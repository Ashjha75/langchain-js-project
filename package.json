{
  "name": "langchain-js-code-agent",
  "version": "1.0.0",
  "description": "Advanced LangChain.js agent for generating Next.js + Express.js code using Google GenAI",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "docker build -t langchain-code-agent .",
    "docker:run": "docker run -p 3000:3000 --env-file .env langchain-code-agent",
    "docker:dev": "docker-compose up --build",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "langchain",
    "google-genai",
    "nextjs",
    "expressjs",
    "code-generation",
    "ai-agent"
  ],
  "author": "Ashish Jha",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "^0.1.0",
    "@neondatabase/serverless": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "langchain": "^0.3.0",
    "pg": "^8.16.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
